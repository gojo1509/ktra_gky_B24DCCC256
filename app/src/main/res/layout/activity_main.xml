<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUẢN LÝ THƯ VIỆN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnManageBooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý danh sách sách"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnManageBorrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản lý mượn / trả sách"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSearchBooks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm kiếm sách"/>
</LinearLayout>